# Copy to .env and adjust:  cp example.env .env

# --- Runtime UID/GID remap of the `frappe` user (templates/docker/compose.uid-gid.yml) ---
# Match your host user so bind-mounted files stay writable. Defaults to 1000/1000 if unset.
USERID=1000
GROUPID=1000

# --- Upstream bench image (non.prod.compose.yml + templates/docker/compose.uid-gid.yml) ---
# The frappe/bench image tag decides the bench CLI version AND the Python/Node toolchain inside it.
# ONE meaning in every stack: run as-is (base stack) or used as the FROM of the locally built
# `bench:${BENCH_TAG}` wrapper (uid-gid override). Upstream publishes `latest` plus one tag per
# bench release
BENCH_IMAGE=frappe/bench
BENCH_TAG=latest
# never = only use images already on the host (run `docker pull` yourself after changing BENCH_TAG);
# missing = pull only if absent; always = pull on every start.
PULL_POLICY=never

# --- Frappe framework ref (non.prod.compose.yml, configurator + frappe) ---
# Git ref of frappe/frappe, passed verbatim to `bench init --frappe-branch`, and also the suffix of
# the bench directory (frappe-bench-<ref>). A branch (version-16, version-15, develop) gives the
# latest release at init time and can later be updated with `bench update`; a tag (v15.x.x or v16.x.x)
# pins one release (detached HEAD). Changing it creates a NEW bench next to the old one.
FRAPPE_BRANCH=version-16

# --- Python for `bench init` (non.prod.compose.yml, configurator) ---
# pyenv version (prefix ok, e.g. 3.12) used to build the bench virtualenv on first start.
# `auto` (or empty) = the image's default python (in frappe/bench:latest), which version-16
# requires and current version-15 supports.
BENCH_PYTHON_VERSION=auto

# --- Bench dev ports (used by local-ports override) ---
# Ports the bench dev server binds INSIDE the container. Defaults are bench's own defaults.
# bench init -> make_ports() gives a second bench 8001/9001, a third 8002/9002, ... Point a
# stack at a non-default bench by bumping these (e.g. FRAPPE_WEB_PORT=8001 / FRAPPE_SOCKETIO_PORT=9001).
FRAPPE_WEB_PORT=8000
FRAPPE_SOCKETIO_PORT=9000
# High bound of the range published locally (local-ports override only). Lets bench's dynamic
# +1 allocation stay reachable on the host without editing the override.
FRAPPE_WEB_PORT_LAST=8005
FRAPPE_SOCKETIO_PORT_LAST=9005

# --- Local ports override (templates/docker/compose.local-ports.yml) ---
# Host interface the bench ports bind to. Loopback-only by default; set 0.0.0.0 to reach it from the LAN.
HOST_BIND=127.0.0.1

# --- HTTPS / Traefik override (templates/docker/compose.non-prod-https.yaml) ---
# Host ports Traefik publishes.
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443
